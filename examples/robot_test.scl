FUNCTION FC_Ternary_BOOL : BOOL
    VAR_INPUT
        c	:	BOOL;
        e1	:	BOOL;
        e0	:	BOOL;
    END_VAR

    BEGIN
    IF #c THEN
        #FC_Ternary_BOOL := #e1;
    ELSE
        #FC_Ternary_BOOL := #e0;
    END_IF;
END_FUNCTION

FUNCTION FC_Ternary_INT : INT
    VAR_INPUT
        c	:	BOOL;
        e1	:	INT;
        e0	:	INT;
    END_VAR

    BEGIN
    IF #c THEN
        #FC_Ternary_INT := #e1;
    ELSE
        #FC_Ternary_INT := #e0;
    END_IF;
END_FUNCTION

FUNCTION FC_Gen_is_valid : BOOL
    VAR_INPUT
        in_0	:	Position;
    END_VAR

    BEGIN
    IF TRUE THEN
        #FC_Gen_is_valid := ((#in_0.x < 4) AND ((#in_0.y < 6) AND (#in_0.z < 2)));
    ELSE
        #FC_Gen_is_valid := FALSE;
    END_IF;
END_FUNCTION

FUNCTION FC_Gen_can_reach : BOOL
    VAR_INPUT
        in_0	:	ARRAY [0..6, 0..3, 0..1] OF INT;
        in_1	:	Position;
    END_VAR

    VAR_TEMP
        binder_var	:	Position;
        iter_0	:	INT;
        iter_1	:	INT;
        iter_2	:	INT;
        binder_res	:	BOOL;
    END_VAR

    BEGIN
    IF TRUE THEN
        #binder_res := TRUE;
        FOR #iter_0 := 0 TO 6 DO
            #binder_var.x := iter_0;
            FOR #iter_1 := 0 TO 3 DO
                #binder_var.y := iter_1;
                FOR #iter_2 := 0 TO 1 DO
                    #binder_var.z := iter_2;

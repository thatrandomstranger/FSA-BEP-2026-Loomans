    ELSE
        #FC_Gen_can_reach := FALSE;
    END_IF;
END_FUNCTION

FUNCTION FC_Gen_has_available : BOOL
    VAR_INPUT
        in_0	:	ARRAY [0..6, 0..3, 0..1] OF INT;
    END_VAR

    VAR_TEMP
        binder_var	:	Position;
        iter_0	:	INT;
        iter_1	:	INT;
        iter_2	:	INT;
        binder_res	:	BOOL;
    END_VAR

    BEGIN
    IF TRUE THEN
        #binder_res := FALSE;
        FOR #iter_0 := 0 TO 6 DO
            #binder_var.x := iter_0;
            FOR #iter_1 := 0 TO 3 DO
                #binder_var.y := iter_1;
                FOR #iter_2 := 0 TO 1 DO
                    #binder_var.z := iter_2;
                    #binder_res := (#binder_res OR (FC_Gen_can_reach(in_0 := #in_0, in_1 := #binder_var) AND (#in_0[#binder_var.x, #binder_var.y, #binder_var.z] = 0)));
                END_FOR;
            END_FOR;
        END_FOR;
        #FC_Gen_has_available := #binder_res;
    ELSE
        #FC_Gen_has_available := FALSE;
    END_IF;
END_FUNCTION

FUNCTION FC_Gen_insert : Void
    VAR_IN_OUT
        in_0	:	ARRAY [0..6, 0..3, 0..1] OF INT;
    END_VAR

    VAR_INPUT
        in_1	:	Position;
        in_2	:	INT;
    END_VAR

    BEGIN
    IF (NOT((#in_2 = 0)) AND FC_Gen_is_valid(in_0 := #in_1)) THEN
        #in_0[#in_1.x, #in_1.y, #in_1.z] := #in_2;
    END_IF;
END_FUNCTION

FUNCTION FC_Gen_pop : Void
    VAR_IN_OUT
        in_0	:	ARRAY [0..6, 0..3, 0..1] OF INT;
    END_VAR

    VAR_INPUT
        in_1	:	Position;
    END_VAR

    BEGIN
    IF FC_Gen_is_valid(in_0 := #in_1) THEN
        #in_0[#in_1.x, #in_1.y, #in_1.z] := 0;
    END_IF;
END_FUNCTION

FUNCTION FC_Gen_toggle_io_mode : INT
    VAR_INPUT
        in_0	:	INT;
    END_VAR

    BEGIN
    IF ((in_0 = 0) AND TRUE) THEN
        #FC_Gen_toggle_io_mode := 1;
    ELSIF ((in_0 = 1) AND TRUE) THEN

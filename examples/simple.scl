FUNCTION FC_Ternary_BOOL : BOOL
    VAR_INPUT
        c	:	BOOL;
        e1	:	BOOL;
        e0	:	BOOL;
    END_VAR

    BEGIN
    IF #c THEN
        #FC_Ternary_BOOL := #e1;
    ELSE
        #FC_Ternary_BOOL := #e0;
    END_IF;
END_FUNCTION

FUNCTION FC_Ternary_Direction : INT
    VAR_INPUT
        c	:	BOOL;
        e1	:	INT;
        e0	:	INT;
    END_VAR

    BEGIN
    IF #c THEN
        #FC_Ternary_Direction := #e1;
    ELSE
        #FC_Ternary_Direction := #e0;
    END_IF;
END_FUNCTION

